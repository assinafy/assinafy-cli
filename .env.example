# Assinafy CLI environment variables (all optional — flags and config file also work)

# Preferred credential — sent as the X-Api-Key header.
ASSINAFY_API_KEY=

# Default workspace / account ID applied to account-scoped commands.
ASSINAFY_ACCOUNT_ID=

# Override the API base URL. Use the sandbox while testing:
#   https://sandbox.assinafy.com.br/v1
# Defaults to https://api.assinafy.com.br/v1
ASSINAFY_BASE_URL=

# Legacy JWT access token (sent as Authorization: Bearer). Prefer ASSINAFY_API_KEY.
ASSINAFY_TOKEN=

# Safer non-interactive alternatives to passing secrets on the command line.
ASSINAFY_PASSWORD=
ASSINAFY_NEW_PASSWORD=
ASSINAFY_PROVIDER_TOKEN=
ASSINAFY_RESET_TOKEN=
ASSINAFY_SIGNER_ACCESS_CODE=
ASSINAFY_VERIFICATION_CODE=

# Experimental verifier only: Assinafy does not publish its webhook signing scheme.
# Do not treat WebhookVerifier as a production trust boundary without independent validation.
ASSINAFY_WEBHOOK_SECRET=

# Named profile to select from the config file (~/.config/assinafy/config.json).
ASSINAFY_PROFILE=

# Override the directory containing config.json.
ASSINAFY_CONFIG_DIR=

# Release-installer settings (read by install.sh / install.ps1, not the CLI).
# Installation root; defaults to ~/.assinafy.
ASSINAFY_INSTALL=

# Set to 1 to keep the installer from changing the user PATH.
ASSINAFY_NO_PATH_UPDATE=

# Advanced mirror overrides; defaults shown in the installers are recommended.
ASSINAFY_REPO=
GITHUB_BASE=

# Opt-in live sandbox smoke test (`npm run test:sandbox`). The test creates and
# removes disposable resources and sends one signing-token email.
ASSINAFY_SANDBOX_BASE_URL=https://sandbox.assinafy.com.br/v1
ASSINAFY_TEST_EMAIL=
ASSINAFY_TEST_EMAIL_ALT=
